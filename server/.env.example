# Copy to server/.env.local, which git ignores. Defaults match deploy/compose.yaml.
# dev is only for this machine: the server refuses it on a public origin or a
# non-loopback address. Anything else needs SESSION_KEY, an https PUBLIC_ORIGIN
# and an explicit TRUSTED_PROXY.
APP_ENV=dev
YOUTUBE_API_KEY=
# Base64 of 32 random bytes. Required outside dev.
SESSION_KEY=
# Lets people play direct .mp4 and .m3u8 links. Off by default.
ALLOW_DIRECT_MEDIA=false
# Set when exactly one proxy sits in front of this server and sets X-Forwarded-For.
# Rate limits then apply to the visitor rather than the proxy. Required outside dev.
TRUSTED_PROXY=false

# Sign-in. Without these, everyone is a guest.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Voice. `make voice-keys` fills these in for local use. Without them there's no voice.
LIVEKIT_URL=
LIVEKIT_API_KEY=
# At least 32 characters.
LIVEKIT_API_SECRET=
